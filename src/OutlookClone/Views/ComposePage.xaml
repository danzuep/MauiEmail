<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OutlookClone.Views.ComposePage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:rich="clr-namespace:RichEdit.Maui;assembly=RichEdit.Maui"
    xmlns:viewModels="clr-namespace:OutlookClone.ViewModels"
    x:DataType="viewModels:SenderViewModel"
    Title="New message">
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto,Auto"
        RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*">
            <Button
                Padding="8"
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"
                FontSize="22"
                SemanticProperties.Description="Back to inbox"
                Text="&#x2190;"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                ToolTipProperties.Text="Back to inbox" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="New message"
                VerticalOptions="Center" />
        </Grid>

        <Entry
            Grid.Row="1"
            Keyboard="Email"
            Placeholder="From"
            Text="{Binding FromTextBox}" />
        <Entry
            Grid.Row="2"
            Keyboard="Email"
            Placeholder="To"
            Text="{Binding ToTextBox}" />
        <Entry
            Grid.Row="3"
            Placeholder="Subject"
            Text="{Binding SubjectTextBox}" />
        <rich:RichEditor
            x:Name="HtmlEditor"
            Grid.Row="4"
            Placeholder="Write your message"
            VerticalOptions="Fill" />
        <Label
            Grid.Row="5"
            FontSize="12"
            Text="{Binding StatusMessage}"
            TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource White}}"
            VerticalOptions="Center" />
        <Button
            Grid.Row="6"
            BackgroundColor="{StaticResource Primary}"
            Clicked="OnSendClicked"
            FontSize="24"
            SemanticProperties.Description="Send email"
            ImageSource="{StaticResource FontIconSend}"
            TextColor="White"
            ToolTipProperties.Text="Send email" />
    </Grid>
</ContentPage>