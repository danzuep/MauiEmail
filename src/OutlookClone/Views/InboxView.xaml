<?xml version="1.0" encoding="utf-8" ?>
<ContentView
    x:Class="OutlookClone.Views.InboxView"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:OutlookClone.Models"
    xmlns:views="clr-namespace:OutlookClone.Views"
    x:DataType="views:InboxView">
    <Grid RowDefinitions="56,*">
        <Grid
            Padding="20,0"
            BackgroundColor="{StaticResource Primary}"
            ColumnDefinitions="Auto,Auto,*,180,Auto,Auto">
            <Label
                FontAttributes="Bold"
                FontSize="20"
                Text="Inbox"
                TextColor="White"
                VerticalOptions="Center" />
            <Button
                x:Name="SettingsButton"
                Grid.Column="1"
                BackgroundColor="Transparent"
                Clicked="OnSettingsClicked"
                FontFamily="FluentRegular"
                FontSize="24"
                SemanticProperties.Description="Open settings"
                Text="&#xf6aa;"
                TextColor="White"
                ToolTipProperties.Text="Settings" />
            <Entry
                x:Name="SearchEntry"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                Grid.Column="3"
                Completed="OnSearchCompleted"
                HeightRequest="40"
                HorizontalOptions="Fill"
                Placeholder="Search"
                PlaceholderColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}"
                ReturnType="Search"
                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                VerticalOptions="Center" />
            <Button
                x:Name="FilterButton"
                Grid.Column="4"
                BackgroundColor="Transparent"
                Clicked="OnFilterClicked"
                FontFamily="FluentRegular"
                FontSize="24"
                SemanticProperties.Description="Show email search filters"
                Text="&#xf408;"
                TextColor="White"
                ToolTipProperties.Text="Search filters"
                VerticalOptions="Center" />
            <Button
                x:Name="SearchButton"
                Grid.Column="5"
                BackgroundColor="Transparent"
                Clicked="OnSearchClicked"
                FontFamily="FluentRegular"
                FontSize="24"
                SemanticProperties.Description="Search email"
                Text="&#xfb26;"
                TextColor="White"
                ToolTipProperties.Text="Search email"
                VerticalOptions="Center" />
        </Grid>

        <Grid Grid.Row="1">
            <CollectionView
                x:Name="MessageCollection"
                Margin="0,8"
                ItemsSource="{Binding Emails}"
                SelectionMode="Single">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:Email">
                        <Grid
                            BackgroundColor="Transparent"
                            Padding="16,10"
                            ColumnDefinitions="*,Auto"
                            RowDefinitions="Auto,Auto,Auto">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal" />
                                    <VisualState Name="Selected">
                                        <VisualState.Setters>
                                            <Setter Property="BackgroundColor" Value="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}" />
                                        </VisualState.Setters>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer
                                    NumberOfTapsRequired="2"
                                    Tapped="OnMessageDoubleTapped" />
                            </Grid.GestureRecognizers>
                            <Label
                                FontAttributes="Bold"
                                Text="{Binding From}"
                                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                            <Label
                                Grid.Column="1"
                                FontSize="12"
                                Text="{Binding Date}"
                                TextColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Gray200}}" />
                            <Label
                                Grid.Row="1"
                                Grid.ColumnSpan="2"
                                Text="{Binding Subject}"
                                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
                            <Label
                                Grid.Row="2"
                                Grid.ColumnSpan="2"
                                LineBreakMode="TailTruncation"
                                Text="{Binding BodyPreview}"
                                TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
                        </Grid>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <ActivityIndicator
                x:Name="LoadingIndicator"
                HorizontalOptions="Center"
                IsVisible="False"
                VerticalOptions="Center"
                Color="{StaticResource Primary}" />

            <Button
                x:Name="LoadMoreButton"
                Margin="20"
                Padding="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource Gray100}, Dark={StaticResource Gray600}}"
                CornerRadius="24"
                FontSize="24"
                HeightRequest="48"
                HorizontalOptions="Center"
                SemanticProperties.Description="Load the next 10 emails"
                Text="&#x2193;"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                VerticalOptions="End"
                WidthRequest="48"
                Clicked="OnLoadMoreClicked" />

            <Button
                Margin="20"
                Padding="0"
                BackgroundColor="{StaticResource Primary}"
                CornerRadius="30"
                FontSize="30"
                HeightRequest="60"
                HorizontalOptions="End"
                SemanticProperties.Description="Compose email"
                Text="+"
                TextColor="White"
                VerticalOptions="End"
                WidthRequest="60"
                Clicked="OnComposeClicked">
                <Button.Shadow>
                    <Shadow Brush="Black" Opacity="0.35" Radius="10" Offset="3,4" />
                </Button.Shadow>
            </Button>
        </Grid>

        <views:InboxFilterPanel
            x:Name="FilterPanel"
            Grid.Row="1"
            Margin="0,8,48,0"
            HorizontalOptions="End"
            IsVisible="False"
            VerticalOptions="Start"
            WidthRequest="300"
            ZIndex="2" />
    </Grid>
</ContentView>