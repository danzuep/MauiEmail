<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="OutlookClone.Views.MessageReaderPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:OutlookClone.Models"
    x:DataType="models:Email"
    Title="Message">
    <Grid
        Padding="20"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,*"
        RowSpacing="12">
        <Grid ColumnDefinitions="Auto,*">
            <Button
                Padding="8"
                BackgroundColor="Transparent"
                Clicked="OnBackClicked"
                FontSize="22"
                SemanticProperties.Description="Back to inbox"
                Text="&#x2190;"
                TextColor="{AppThemeBinding Light={StaticResource Primary}, Dark={StaticResource White}}"
                ToolTipProperties.Text="Back to inbox" />
            <Label
                Grid.Column="1"
                FontAttributes="Bold"
                FontSize="20"
                HorizontalOptions="Center"
                Text="Message"
                VerticalOptions="Center" />
        </Grid>
        <Label
            Grid.Row="1"
            FontAttributes="Bold"
            FontSize="24"
            Text="{Binding Subject}"
            TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        <Label
            Grid.Row="2"
            FontSize="14"
            Text="{Binding From, StringFormat='From: {0}'}"
            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
        <Label
            Grid.Row="3"
            FontSize="14"
            Text="{Binding To, StringFormat='To: {0}'}"
            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
        <Label
            Grid.Row="4"
            FontSize="12"
            Text="{Binding Date}"
            TextColor="{AppThemeBinding Light={StaticResource Gray600}, Dark={StaticResource Gray200}}" />
        <ScrollView Grid.Row="5">
            <Label
                LineBreakMode="WordWrap"
                Text="{Binding BodyText}"
                TextColor="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}"
                VerticalOptions="Start" />
        </ScrollView>
    </Grid>
</ContentPage>